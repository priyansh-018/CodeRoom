generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Interviewer {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  avatarUrl    String?   @db.Text
  bio          String?   @db.Text
  title        String?   @default("Senior Technical Interviewer")
  company      String?   @default("CodeRoom Host")
  organization String?
  position     String?
  phone        String?
  github       String?
  linkedin     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdRooms Room[]    @relation("InterviewerRooms")
  sessions     Session[] @relation("InterviewerSessions")

  @@map("interviewers")
}

model Candidate {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String
  passwordHash        String
  avatarUrl           String?   @db.Text
  bio                 String?   @db.Text
  title               String?   @default("Software Engineering Candidate")
  university          String?
  graduationYear      String?
  phone               String?
  qualificationStatus String?
  degree              String?
  skills              String?   @db.Text
  resumeUrl           String?   @db.Text
  resumeFileName      String?
  github              String?
  linkedin            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions       Session[] @relation("CandidateSessions")

  @@map("candidates")
}

model Room {
  id        String       @id @default(uuid())
  title     String       @default("Technical Mock Interview")
  language  String       @default("javascript")
  code      String?      @db.Text
  creatorId String?
  creator   Interviewer? @relation("InterviewerRooms", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sessions  Session[]

  @@map("rooms")
}

model Session {
  id             String         @id @default(uuid())
  roomId         String
  room           Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hostId         String?
  host           Interviewer?   @relation("InterviewerSessions", fields: [hostId], references: [id], onDelete: SetNull)
  guestId        String?
  guest          Candidate?     @relation("CandidateSessions", fields: [guestId], references: [id], onDelete: SetNull)
  language       String         @default("javascript")
  problemName    String?
  summary        String?        @db.Text
  score          Int?
  violationCount Int            @default(0)
  startedAt      DateTime       @default(now())
  endedAt        DateTime?

  events         SessionEvent[]

  @@map("sessions")
}

enum EventType {
  DELTA
  RUN
  AI_FEEDBACK
  CHAT
  CURSOR
  PROCTOR_VIOLATION
}

model SessionEvent {
  id        String    @id @default(uuid())
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      EventType
  payload   Json
  timestamp DateTime  @default(now())

  @@index([sessionId, timestamp])
  @@map("session_events")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_otps")
}
